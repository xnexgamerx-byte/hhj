# عنوان الخادم الذي يتصل به التطبيق.
#
# اتركه فارغاً أثناء التطوير: التطبيق يستنتج عنوان حاسوبك من العنوان الذي
# نزّلت منه شفرته، فتعمل التجربة على هاتف حقيقي بلا إعداد.
#
# وإن تعذّر الاستنتاج — يقول التطبيق ذلك صراحةً — اكتب العنوان هنا. هذا
# السطر يسبق كل استنتاج، فهو المخرج المضمون:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:3000
#
# عنوان حاسوبك يطبعه الخادم عند إقلاعه، أو: cd api && npm run check:phone
#
# ولتغيير المنفذ وحده مع بقاء الاستنتاج للعنوان:
# EXPO_PUBLIC_API_PORT=3000
