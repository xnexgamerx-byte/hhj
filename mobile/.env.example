# عنوان الخادم الذي يتصل به التطبيق.
#
# اتركه فارغاً أثناء التطوير: التطبيق يستنتج عنوان حاسوبك من خادم Expo
# ويستعمل المنفذ ٣٠٠٠ تلقائياً، فتعمل التجربة على هاتف حقيقي بلا إعداد.
#
# عيّنه صراحةً إن كان الخادم على منفذ أو جهاز مختلف:
# EXPO_PUBLIC_API_URL=http://192.168.1.5:3000
#
# أو غيّر المنفذ وحده واترك الاستنتاج يتكفّل بالعنوان:
# EXPO_PUBLIC_API_PORT=3000
