# إعدادات الخادم على Hetzner — ينسخها setup.sh إلى .env ويولّد الأسرار.
# راجع docs/hetzner-cloudflare.md خطوةً بخطوة.

# ── الدومين ─────────────────────────────────────────────────────
# عنوان الخادم الذي يكلّمه التطبيق واللوحات. سجلّه في Cloudflare من نوع A
# يشير إلى عنوان الخادم، و«DNS only» (السحابة رمادية).
API_DOMAIN=api.example.com
# تراسلك Let's Encrypt عليه إن تعذّر تجديد شهادة HTTPS
ACME_EMAIL=you@example.com

# مواقع اللوحات ونسخة التطبيق للويب على Cloudflare Pages — المسموح لها
# وحدها بمكالمة الخادم من المتصفّح. عدّة مواقع تُفصل بفاصلة
WEB_ORIGIN=https://example.com,https://www.example.com,https://app.example.com

# ── الأسرار ── يولّدها setup.sh؛ لا تكتبها بيدك ────────────────────
DB_PASSWORD=
JWT_SECRET=

# ── حساب المالك الأول ───────────────────────────────────────────
# لا يُستعمل إن نُقلت البيانات من Render: الحساب موجود هناك بباسووردهِ،
# والتعبئة لا تمسّ حساباً قائماً
OWNER_EMAIL=you@example.com
OWNER_PASSWORD=
OWNER_NAME="مالك المنصة"

# ── واتساب ─────────────────────────────────────────────────────
# انسخهما من إعدادات Render إن كانا معبّأين هناك
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

DEFAULT_TIMEZONE=Asia/Baghdad
LOG_LEVEL=info
