# Caddy يصدر شهادة HTTPS لعنوان الخادم من Let's Encrypt ويجدّدها وحده،
# ويحوّل http إلى https. يكفي أن يشير سجلّ الدومين إلى الخادم.
{
	email {$ACME_EMAIL}
}

{$API_DOMAIN} {
	# قوائم الأطباء والمواعيد نصٌّ يُضغط جيداً على شبكات الهاتف. والصور
	# مضغوطة أصلاً، فضغطها ثانيةً معالجٌ مشغول بلا فائدة
	encode {
		gzip
		match {
			header Content-Type application/json*
			header Content-Type text/*
		}
	}

	reverse_proxy api:3000
}
