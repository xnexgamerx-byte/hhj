// نموذج بيانات تطبيق حجز مواعيد الأطباء
// كل التعليقات بالعربية لأن الفريق عربي؛ أسماء الحقول بالإنجليزية لأنها تظهر في الكود.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════
//  المواقع الجغرافية
//  الهرم: الدولة ← المحافظة ← القضاء ← الحي ← نقطة العيادة
//  كلها بيانات قابلة للتعديل من لوحة الإدارة، لا ثوابت في الكود.
// ═══════════════════════════════════════════════════════════

model Country {
  id       Int    @id @default(autoincrement())
  code     String @unique /// رمز آيزو: IQ
  nameAr   String
  nameEn   String
  dialCode String /// مفتاح الهاتف: +964
  timezone String /// Asia/Baghdad

  governorates Governorate[]

  @@map("countries")
}

model Governorate {
  id        Int     @id @default(autoincrement())
  countryId Int
  slug      String  @unique /// معرّف ثابت في الروابط: baghdad
  nameAr    String
  nameEn    String
  centerLat Float? /// مركز تقريبي لتوسيط الخريطة
  centerLng Float?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true) /// محافظة لم نطلق فيها بعد تُخفى دون حذف

  country   Country    @relation(fields: [countryId], references: [id])
  districts District[]
  clinics   Clinic[]

  @@index([countryId, isActive])
  @@map("governorates")
}

model District {
  id            Int     @id @default(autoincrement())
  governorateId Int
  slug          String
  nameAr        String
  nameEn        String
  isActive      Boolean @default(true)

  governorate Governorate @relation(fields: [governorateId], references: [id])
  areas       Area[]
  clinics     Clinic[]

  @@unique([governorateId, slug])
  @@index([governorateId, isActive])
  @@map("districts")
}

/// الحي أو المنطقة — اختياري، يُستخدم في المدن الكثيفة فقط (بغداد، الموصل، البصرة)
model Area {
  id         Int     @id @default(autoincrement())
  districtId Int
  nameAr     String
  nameEn     String?
  isActive   Boolean @default(true)

  district District @relation(fields: [districtId], references: [id])
  clinics  Clinic[]

  @@index([districtId, isActive])
  @@map("areas")
}

// ═══════════════════════════════════════════════════════════
//  المستخدمون والحسابات
// ═══════════════════════════════════════════════════════════

enum UserRole {
  PATIENT /// مريض — يدخل برقم الهاتف ورمز تحقق
  DOCTOR /// طبيب — يدخل بإيميل وباسوورد ينشئهما المالك
  STAFF /// سكرتير — يدخل بإيميل وباسوورد ينشئهما المالك
  OWNER /// المالك — هو وحده من يسجّل الأطباء وينشئ حساباتهم
}

/// مساران للدخول لا مسار واحد:
///   المريض  → رقم هاتف + رمز تحقق، بلا باسوورد إطلاقاً (أقل احتكاك)
///   الطبيب والسكرتير والمالك → إيميل + باسوورد ينشئهما المالك
/// لذلك phone وemail كلاهما اختياري، ويضمن قيد قاعدة البيانات تفرّد الموجود منهما.
model User {
  id                 String    @id @default(uuid())
  phone              String?   @unique /// بصيغة E.164: ‎+9647XXXXXXXXX — للمرضى
  email              String?   @unique /// للطبيب والسكرتير والمالك
  fullName           String
  role               UserRole  @default(PATIENT)
  passwordHash       String? /// scrypt — لا يُخزَّن الباسوورد نفسه أبداً
  /// المالك ينشئ باسووردًا أولياً ويسلّمه للطبيب، فيُلزَم الطبيب بتغييره أول دخول
  mustChangePassword Boolean   @default(false)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime? /// قفل مؤقت بعد محاولات دخول فاشلة متتالية
  isActive           Boolean   @default(true)
  lastLoginAt        DateTime?
  lastSeenAt         DateTime?
  /// المالك الذي أنشأ هذا الحساب — فارغ للمرضى لأنهم يسجّلون أنفسهم
  createdByUserId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdBy          User?             @relation("AccountCreatedBy", fields: [createdByUserId], references: [id])
  createdAccounts    User[]            @relation("AccountCreatedBy")
  doctor             Doctor?
  staffMember        StaffMember?
  patients           Patient[] /// نفسه + أفراد عائلته
  bookedAppointments Appointment[]     @relation("BookedByUser")
  registeredDoctors  Doctor[]          @relation("DoctorRegisteredBy")
  refreshTokens      RefreshToken[]
  devices            Device[]
  notifications      NotificationLog[]
  auditEntries       AuditLog[]
  settlements        Settlement[]

  @@index([role, isActive])
  @@map("users")
}

/// جلسات طويلة الأمد لتطبيق الجوال — لا يُخزَّن الرمز نفسه بل تجزئته
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

/// رموز التحقق المرسلة بالرسائل النصية. يُخزَّن التجزئة لا الرمز نفسه.
model OtpCode {
  id         String    @id @default(uuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([phone, expiresAt])
  @@map("otp_codes")
}

/// أجهزة المستخدم لإرسال الإشعارات
model Device {
  id        String   @id @default(uuid())
  userId    String
  pushToken String   @unique
  platform  String /// android | ios | web
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@map("devices")
}

enum Gender {
  MALE
  FEMALE
}

/// الشخص الذي يُكشف عليه — قد يكون صاحب الحساب نفسه أو أحد أفراد عائلته.
/// فصله عن User هو ما يسمح للأب بالحجز لأولاده ووالديه من حساب واحد.
model Patient {
  id        String   @id @default(uuid())
  accountId String /// الحساب المالك
  fullName  String
  isSelf    Boolean  @default(false) /// هل هو صاحب الحساب نفسه
  birthYear Int?
  gender    Gender?
  phone     String? /// رقم بديل للتواصل إن اختلف عن صاحب الحساب
  /// عنوان السكن — تسأله العيادة عادةً في الزيارة الأولى، فنسأله مرّة ونحفظه
  address   String?
  createdAt DateTime @default(now())

  account      User             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  blocks       BlockedPatient[]
  waitlist     WaitlistEntry[]

  @@index([accountId])
  @@map("patients")
}

// ═══════════════════════════════════════════════════════════
//  محتوى الواجهة الذي يحرّره المالك
// ═══════════════════════════════════════════════════════════

/// لافتات الشاشة الرئيسية — يضيفها المالك ويرتّبها ويحذفها بلا إصدار جديد.
/// النصّ اختياري: لافتةٌ مصمّمةٌ كاملةً في الصورة لا تحتاج عنواناً فوقها.
model Banner {
  id        String   @id @default(uuid())
  imageUrl  String?
  title     String?
  body      String?
  /// وجهة الضغط: specialty | clinic | doctor | url — وفارغة تعني بحثاً عاماً
  linkKind  String?
  linkValue String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("banners")
}

/// إعدادات يغيّرها المالك من لوحته — مدّة تبديل اللافتة وما شابه.
/// جدول مفتاح/قيمة لا أعمدة: كل إعدادٍ جديد لا يستحقّ ترحيلاً في قاعدة البيانات.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("app_settings")
}

// ═══════════════════════════════════════════════════════════
//  الأطباء والتخصصات
// ═══════════════════════════════════════════════════════════

model Specialty {
  id        Int      @id @default(autoincrement())
  slug      String   @unique
  nameAr    String
  nameEn    String
  aliases   String[] /// أسماء شائعة أخرى ليجدها المريض بأي صيغة كتبها
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  doctors DoctorSpecialty[]

  @@map("specialties")
}

/// لا يوجد تسجيل ذاتي للأطباء: المالك هو من يسجّل كل طبيب وينشئ حسابه.
/// لذلك لا توجد قائمة انتظار مراجعة — كل طبيب على المنصة موثّق بحكم أن المالك أدخله بنفسه،
/// وهذا أقوى في بناء الثقة من مراجعة وثائق يرفعها مجهول.
model Doctor {
  id                String  @id @default(uuid())
  userId            String  @unique
  title             String  @default("د.") /// د. | أ.د. | أ.م.د.
  bio               String?
  yearsOfExperience Int?
  gender            Gender?
  photoUrl          String?
  licenseNumber     String? /// رقم عضوية نقابة الأطباء — يسجّله المالك للأرشيف
  licenseDocUrl     String? /// صورة الوثيقة

  /// رقم واتساب الطبيب الذي تصله تفاصيل الحجوزات.
  /// بصيغة E.164 بلا رموز: ‎+9647XXXXXXXXX
  whatsappNumber  String?
  /// يوقف إرسال الواتساب لهذا الطبيب دون تعطيل حسابه
  whatsappEnabled Boolean @default(true)

  /// هل يظهر للمرضى في نتائج البحث
  isPublished Boolean @default(true)
  isActive    Boolean @default(true)

  /// متوسط التقييم وعدده — محسوبان عند كل تقييم جديد.
  /// حسابهما لحظة كل بحث يعني تجميعاً على كل الحجوزات في كل طلب.
  ratingAvg   Float @default(0)
  ratingCount Int   @default(0)

  /// المالك الذي سجّل هذا الطبيب ومتى
  registeredByUserId String?
  registeredAt       DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredBy    User?             @relation("DoctorRegisteredBy", fields: [registeredByUserId], references: [id])
  specialties     DoctorSpecialty[]
  practices       DoctorClinic[]
  blockedPatients BlockedPatient[]
  reviews         Review[]
  commissions     Commission[]

  @@index([isPublished, isActive])
  @@map("doctors")
}

model DoctorSpecialty {
  doctorId    String
  specialtyId Int
  isPrimary   Boolean @default(false)

  doctor    Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  specialty Specialty @relation(fields: [specialtyId], references: [id])

  @@id([doctorId, specialtyId])
  @@index([specialtyId])
  @@map("doctor_specialties")
}

// ═══════════════════════════════════════════════════════════
//  العيادات والممارسة
// ═══════════════════════════════════════════════════════════

model Clinic {
  id            String   @id @default(uuid())
  nameAr        String
  governorateId Int
  districtId    Int
  areaId        Int?
  /// العلامة المميزة: «مقابل مستشفى الجمهورية، فوق صيدلية النور».
  /// يُستخدم عملياً أكثر من الخريطة لأن العناوين غير منتظمة.
  landmark      String?
  addressLine   String?
  lat           Float?
  lng           Float?
  phone         String?
  timezone      String   @default("Asia/Baghdad")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  governorate Governorate    @relation(fields: [governorateId], references: [id])
  district    District       @relation(fields: [districtId], references: [id])
  area        Area?          @relation(fields: [areaId], references: [id])
  practices   DoctorClinic[]
  staff       StaffMember[]
  commissions Commission[]
  settlements Settlement[]

  @@index([governorateId, isActive])
  @@index([districtId, isActive])
  @@map("clinics")
}

enum BookingMode {
  SLOT /// موعد بوقت محدد: ٤:٠٠، ٤:٢٠، ٤:٤٠
  QUEUE /// رقم دور ضمن فترة: «الدور ١٢ بين ٤ و٧ مساءً»
}

/// ممارسة طبيب في عيادة معيّنة.
/// الفصل عن Doctor يسمح للطبيب بالعمل في أكثر من موقع، لكل موقع جدوله وسعره ونمط حجزه.
model DoctorClinic {
  id                  String      @id @default(uuid())
  doctorId            String
  clinicId            String
  feeAmount           Int /// سعر الكشف
  currency            String      @default("IQD")
  bookingMode         BookingMode @default(QUEUE)
  slotMinutes         Int         @default(15) /// مدة الكشف — لنمط SLOT
  capacityPerSession  Int         @default(20) /// عدد المرضى في الفترة — لنمط QUEUE
  autoConfirm         Boolean     @default(true) /// تأكيد فوري أم بانتظار موافقة العيادة
  cancelCutoffMinutes Int         @default(120) /// آخر مهلة للإلغاء قبل الموعد
  bookingHorizonDays  Int         @default(14) /// إلى أي مدى مستقبلاً يُسمح بالحجز
  /// يتجاوز رقم واتساب الطبيب لهذا الموقع تحديداً — لعيادة لها سكرتير برقم خاص
  whatsappNumber      String?
  /// عمولة المنصة على كل مريض يحضر فعلاً عند هذا الطبيب في هذه العيادة.
  /// صفر = بلا عمولة. تُستحق عند الحضور لا عند الحجز، فالعيادة لا تدفع عن
  /// مريض لم يأتِ — وهذا ما يجعلها تقبل الاتفاق أصلاً.
  commissionAmount    Int         @default(0)
  isActive            Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  doctor       Doctor              @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  clinic       Clinic              @relation(fields: [clinicId], references: [id])
  schedules    ScheduleTemplate[]
  exceptions   ScheduleException[]
  appointments Appointment[]
  staff        StaffMember[]
  waitlist     WaitlistEntry[]
  commissions  Commission[]

  @@unique([doctorId, clinicId])
  @@index([clinicId, isActive])
  @@map("doctor_clinics")
}

/// السكرتير — المستخدم اليومي الحقيقي للوحة التحكم.
/// صلاحياته أقل من الطبيب: يدير الحجوزات ولا يعدّل السعر أو الملف.
model StaffMember {
  id                String   @id @default(uuid())
  userId            String   @unique
  clinicId          String?
  doctorClinicId    String?
  canManageSchedule Boolean  @default(false)
  canManageProfile  Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinic              Clinic?       @relation(fields: [clinicId], references: [id])
  doctorClinic        DoctorClinic? @relation(fields: [doctorClinicId], references: [id])
  createdAppointments Appointment[] @relation("CreatedByStaff")

  @@index([clinicId, isActive])
  @@map("staff_members")
}

// ═══════════════════════════════════════════════════════════
//  الجداول والدوام
//  نخزّن القالب والاستثناءات فقط، ونحسب الفترات المتاحة لحظة العرض.
//  توليد الفترات وتخزينها مسبقاً يعني إصلاح آلاف الصفوف عند كل تعديل دوام.
// ═══════════════════════════════════════════════════════════

/// قالب الدوام الأسبوعي المتكرر
model ScheduleTemplate {
  id             String  @id @default(uuid())
  doctorClinicId String
  weekday        Int /// ٠ = الأحد … ٦ = السبت
  startTime      String /// "16:00" بتوقيت العيادة
  endTime        String /// "19:00"
  slotMinutes    Int? /// يتجاوز إعداد الممارسة إن حُدِّد
  capacity       Int? /// يتجاوز إعداد الممارسة إن حُدِّد
  isActive       Boolean @default(true)

  doctorClinic DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)

  @@unique([doctorClinicId, weekday, startTime])
  @@index([doctorClinicId, isActive])
  @@map("schedule_templates")
}

enum ExceptionType {
  CLOSED /// إجازة أو إغلاق — يُلغى ما فيه من حجوزات مع إشعار
  CUSTOM /// دوام مختلف عن المعتاد في هذا اليوم
}

model ScheduleException {
  id             String        @id @default(uuid())
  doctorClinicId String
  date           DateTime      @db.Date
  type           ExceptionType
  startTime      String?
  endTime        String?
  capacity       Int?
  reason         String?
  createdAt      DateTime      @default(now())

  doctorClinic DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)

  @@index([doctorClinicId, date])
  @@map("schedule_exceptions")
}

// ═══════════════════════════════════════════════════════════
//  المواعيد — قلب النظام
// ═══════════════════════════════════════════════════════════

enum AppointmentStatus {
  HELD /// محجوز مؤقتاً أثناء إتمام الدفع، يُحرَّر تلقائياً عند انتهاء المهلة
  PENDING /// بانتظار موافقة العيادة
  CONFIRMED /// مؤكَّد
  CANCELLED_BY_PATIENT
  CANCELLED_BY_CLINIC
  NO_SHOW /// لم يحضر
  COMPLETED /// انتهى الكشف
}

model Appointment {
  id        String @id @default(uuid())
  /// رقم مرجعي قصير يقرأه المريض للسكرتير
  reference String @unique

  doctorClinicId   String
  patientId        String
  bookedByUserId   String /// الحساب الذي أجرى الحجز
  createdByStaffId String? /// موجود إن كان حجزاً يدوياً أضافه السكرتير

  /// لقطة من نمط الحجز وقت إنشائه — تغيير إعداد الطبيب لاحقاً يجب ألا يغيّر حجوزات قائمة
  bookingMode  BookingMode
  sessionStart DateTime /// بداية فترة الدوام
  sessionEnd   DateTime /// نهايتها
  /// SLOT: وقت الموعد نفسه. QUEUE: يساوي sessionStart.
  slotStart    DateTime
  /// SLOT: صفر دائماً. QUEUE: رقم الدور.
  queueNumber  Int         @default(0)

  /// يوم الزيارة بتوقيت العيادة "YYYY-MM-DD".
  /// عمودٌ صريح لا مشتقّ: ترقيم اليوم يحتاج قيداً فريداً، والقيد لا يقوم على
  /// تعبيرٍ محسوب. وهو يجعل استعلام «حجوزات اليوم» فهرساً بدل ترشيحٍ في الذاكرة.
  serviceDate String?
  /// رقم المريض ذلك اليوم في تلك العيادة — هذا ما يحفظه ويُنادى به عند الحضور.
  /// لا يُعاد استعماله بعد الإلغاء: رقمٌ في يد مريضين يوماً واحداً فوضى.
  /// NULL في الصفوف السابقة للترقيم — وبوستغرس يعدّ NULL مختلفاً فلا تتصادم.
  dailyNumber Int?

  status AppointmentStatus @default(CONFIRMED)

  /// مفتاح القفل: true ما دام الحجز يشغل المكان، وNULL بعد الإلغاء.
  /// بوستغرس يعتبر قيم NULL مختلفة في القيود الفريدة، فيصبح المكان حراً لغيره
  /// بينما يبقى صف الحجز الملغى محفوظاً في السجل. هذا هو خط الدفاع الحقيقي
  /// ضد الحجز المزدوج — أي تحقق في الكود وحده ينكسر عند ضغطتين متزامنتين.
  lockKey Boolean?

  holdExpiresAt DateTime? /// لحالة HELD
  patientNote   String?
  clinicNote    String?

  confirmedAt  DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  cancelledAt  DateTime?
  cancelReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  doctorClinic     DoctorClinic      @relation(fields: [doctorClinicId], references: [id])
  patient          Patient           @relation(fields: [patientId], references: [id])
  bookedByUser     User              @relation("BookedByUser", fields: [bookedByUserId], references: [id])
  createdByStaff   StaffMember?      @relation("CreatedByStaff", fields: [createdByStaffId], references: [id])
  review           Review?
  notificationLogs NotificationLog[]
  commission       Commission?

  /// القيد الذي يمنع حجز نفس المكان مرتين
  @@unique([doctorClinicId, slotStart, queueNumber, lockKey])
  /// والقيد الذي يمنع إعطاء رقمٍ واحد لمريضين في يومٍ واحد
  @@unique([doctorClinicId, serviceDate, dailyNumber])
  @@index([doctorClinicId, sessionStart, status])
  @@index([doctorClinicId, serviceDate])
  @@index([patientId, sessionStart])
  @@index([status, holdExpiresAt])
  @@map("appointments")
}

/// لا يقيّم إلا من حضر فعلاً — الشرط الوحيد الذي يحمي التقييمات من التزوير.
/// القيد الفريد على الحجز يمنع تقييمين لنفس الزيارة.
model Review {
  id            String   @id @default(uuid())
  appointmentId String   @unique
  /// مكرَّر من الحجز عمداً: يجعل «تقييمات هذا الطبيب» استعلاماً مباشراً
  /// بلا ربط عبر جدولين في كل مرة
  doctorId      String
  rating        Int /// ١ إلى ٥
  comment       String?
  /// التعليقات تُنشر بعد مراجعة المالك؛ الدرجة تُحتسب فوراً
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctor      Doctor      @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, createdAt])
  @@map("reviews")
}

/// اليوم ممتلئ؟ المريض ينتظر دوره، وإذا ألغى أحدهم يصله إشعار فوري
model WaitlistEntry {
  id             String    @id @default(uuid())
  doctorClinicId String
  patientId      String
  date           DateTime  @db.Date
  notifiedAt     DateTime?
  createdAt      DateTime  @default(now())

  doctorClinic DoctorClinic @relation(fields: [doctorClinicId], references: [id], onDelete: Cascade)
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorClinicId, patientId, date])
  @@index([doctorClinicId, date])
  @@map("waitlist_entries")
}

/// حظر مريض بعد تكرار الغياب
model BlockedPatient {
  id        String   @id @default(uuid())
  doctorId  String
  patientId String
  reason    String?
  createdAt DateTime @default(now())

  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([doctorId, patientId])
  @@map("blocked_patients")
}

enum NotificationChannel {
  PUSH
  SMS
  WHATSAPP
}

enum CommissionStatus {
  DUE /// مستحقة على العيادة ولم تُحصَّل بعد
  SETTLED /// حُصِّلت ضمن تسوية
  WAIVED /// أسقطها المالك
}

/// عمولة على زيارة واحدة حضر فيها المريض فعلاً.
/// صف لكل زيارة لا مجموعٌ محسوب: المالك يحتاج أن يبيّن للعيادة على أي مريض
/// بالضبط يطالبها، وإلا صار كل حساب شهري خلافاً.
model Commission {
  id             String           @id @default(uuid())
  appointmentId  String           @unique
  doctorClinicId String
  clinicId       String
  doctorId       String
  amount         Int
  status         CommissionStatus @default(DUE)
  /// لحظة حضور المريض — لا لحظة الحجز
  earnedAt       DateTime
  settlementId   String?
  waivedReason   String?
  createdAt      DateTime         @default(now())

  appointment  Appointment  @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  doctorClinic DoctorClinic @relation(fields: [doctorClinicId], references: [id])
  clinic       Clinic       @relation(fields: [clinicId], references: [id])
  doctor       Doctor       @relation(fields: [doctorId], references: [id])
  settlement   Settlement?  @relation(fields: [settlementId], references: [id])

  @@index([clinicId, status])
  @@index([status, earnedAt])
  @@map("commissions")
}

/// واقعة تحصيل: المالك قبض مبلغاً من عيادة مقابل عمولات فترة.
/// تسجيلها يجعل «ماذا قبضتُ ومتى ومقابل ماذا» سؤالاً له جواب واحد.
model Settlement {
  id                String   @id @default(uuid())
  clinicId          String
  amount            Int
  count             Int /// عدد الزيارات المشمولة
  note              String?
  collectedByUserId String
  createdAt         DateTime @default(now())

  clinic      Clinic       @relation(fields: [clinicId], references: [id])
  collectedBy User         @relation(fields: [collectedByUserId], references: [id])
  commissions Commission[]

  @@index([clinicId, createdAt])
  @@map("settlements")
}

/// سجل كل رسالة خارجة — إشعار، رسالة نصية، أو رسالة واتساب.
/// وجودها كصفوف لا كنداءات مباشرة يسمح بإعادة المحاولة وبمعرفة ما وصل وما لم يصل.
model NotificationLog {
  id                String              @id @default(uuid())
  userId            String? /// المستلم إن كان له حساب
  appointmentId     String? /// الحجز الذي سبّب الرسالة
  channel           NotificationChannel
  template          String /// doctor_new_booking | booking_confirmed | reminder_24h …
  /// الوجهة الفعلية: رقم واتساب أو هاتف أو رمز جهاز
  toAddress         String?
  payload           Json?
  /// نص الرسالة كما أُرسل — يفيد عند أي نزاع «ما وصلني شيء»
  renderedBody      String?
  status            NotificationStatus  @default(QUEUED)
  attempts          Int                 @default(0)
  error             String?
  /// معرّف الرسالة عند المزوّد، لتتبّع حالة التسليم لاحقاً
  providerMessageId String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  user        User?        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  /// رسالة واحدة من كل نوع لكل حجز — يمنع إرسال تذكير مرتين لو تداخل
  /// تشغيلان للمجدوِل، أو أُعيد تشغيل الخادم أثناء الإرسال.
  /// الصفوف بلا حجز (appointmentId فارغ) لا يمسّها القيد لأن بوستغرس
  /// يعتبر قيم NULL مختلفة.
  @@unique([appointmentId, template])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([appointmentId])
  @@map("notification_logs")
}

enum NotificationStatus {
  QUEUED /// في الطابور، لم تُرسل بعد
  SENT /// سلّمها المزوّد
  FAILED /// فشلت بعد استنفاد المحاولات
}

/// من عدّل ماذا ومتى — ضروري عند أي نزاع بين مريض وعيادة
model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entity      String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([entity, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_logs")
}
