# ── قاعدة البيانات ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mawid?schema=public"

# ── الخادم ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# سر توقيع رموز الدخول — ٣٢ خانة على الأقل.
# ولّده بـ: openssl rand -base64 48
JWT_SECRET=""

# ── حساب المالك الأول ───────────────────────────────────────────
# يُنشأ عند تشغيل npm run db:seed. المالك وحده يسجّل الأطباء.
OWNER_EMAIL="owner@example.com"
OWNER_PASSWORD=""
OWNER_NAME="مالك المنصة"

# ── واتساب (WhatsApp Cloud API من ميتا) ─────────────────────────
# اتركهما فارغين أثناء التطوير: تُطبع الرسائل في الطرفية مع رابط wa.me
# بدل إرسالها فعلياً.
#
# لتفعيل الإرسال الحقيقي يلزم:
#   ١. حساب Meta Business موثّق
#   ٢. رقم هاتف مخصص للـ API — لا يعود صالحاً لتطبيق واتساب العادي
#   ٣. اعتماد قالبَي new_booking وbooking_cancelled من ميتا بالعربية
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ── المنطقة الزمنية ─────────────────────────────────────────────
DEFAULT_TIMEZONE="Asia/Baghdad"

# ── الواجهة ─────────────────────────────────────────────────────
# أصل موقع الويب المسموح له بالاتصال بالخادم. عدّة أصول تُفصل بفاصلة.
WEB_ORIGIN="http://localhost:3001"
