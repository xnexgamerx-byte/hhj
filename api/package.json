{
  "name": "@mawid/api",
  "version": "0.1.0",
  "private": true,
  "description": "خادم تطبيق حجز مواعيد الأطباء",
  "type": "module",
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed/index.ts",
    "db:demo": "tsx prisma/seed/demo.ts",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "verify:booking": "tsx scripts/verify-booking-lock.ts",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "verify:owner": "tsx scripts/verify-owner-and-whatsapp.ts",
    "verify": "npm run typecheck && npm run verify:booking && npm run verify:owner && npm run verify:availability && npm run verify:features",
    "verify:availability": "tsx scripts/verify-availability.ts",
    "verify:features": "tsx scripts/verify-features.ts",
    "owner:reset": "tsx scripts/reset-owner.ts",
    "env:fix": "node scripts/setup-env.mjs",
    "check:phone": "node scripts/check-phone-reach.mjs",
    "tunnel": "node scripts/tunnel.mjs",
    "dev:public": "node scripts/dev-public.mjs",
    "doctor": "node scripts/doctor.mjs"
  },
  "prisma": {
    "seed": "tsx prisma/seed/index.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@prisma/client": "^6.2.1",
    "fastify": "^5.12.1",
    "jose": "^6.2.10"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
